# Use "http://SERVER_IP" until a domain is ready. For automatic HTTPS, use
# only the hostname, for example: alarm.example.com
RELAY_IP_ADDRESS=127.0.0.1

HOYO_DATABASE_PATH=/data/hoyo-relay.sqlite3
HOYO_RETENTION_DAYS=30

# Generate each value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HOYO_MASTER_TOKEN=replace-with-at-least-32-random-characters
HOYO_DEVICE_TOKENS={"slave-01":"replace-with-at-least-32-random-characters"}
