# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
build/
dist/

# Runtime data
runtime/
output/
recordings/
frames/
runs/
*.mp4
*.mkv
*.avi
*.mov
*.jpg
*.jpeg
*.png
*.webp

# YOLO dataset images and trained weights can be large/private.
datasets/**/inbox/*
!datasets/**/inbox/.gitkeep
datasets/**/images/*
!datasets/**/images/train/
datasets/**/images/train/*
!datasets/**/images/train/.gitkeep
!datasets/**/images/val/
datasets/**/images/val/*
!datasets/**/images/val/.gitkeep
!datasets/**/images/test/
datasets/**/images/test/*
!datasets/**/images/test/.gitkeep
models/**/*.pt

# Local secrets and settings
.env
*.local.toml
deployment-credentials.json
*.pem
*.key
*.sqlite3
server/certbot/
server/Caddyfile.runtime

# Private/custom alarm media. The application generates a built-in alarm
# melody when this optional file is absent.
*.flac
assets/sounds/inventory_alert.wav

# Versioned visual templates
!assets/
!assets/templates/
!assets/templates/*.png
